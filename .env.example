# ==============================================================================
# SECUREVAULT — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# PAYLOAD CMS & POSTGRESQL DATABASE
# ==============================================================================
# PostgreSQL Connection URL (Postgres 14+)
# Example: postgresql://username:password@localhost:5432/securevault
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securevault

# Payload Secret (Generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your_32_byte_minimum_payload_secret_key_here

# Server Session HMAC Secret for signing HttpOnly SIWE cookies
# In production, set to a strong 32+ character random string: openssl rand -base64 32
AUTH_SESSION_SECRET=your_super_secret_32_byte_hmac_key_here

# ==============================================================================
# IPFS / PINATA CONFIGURATION
# ==============================================================================
# Pinata JWT (SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_)
# Generate at: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_token_here

# Optional Pinata API Key & Secret (if using legacy API headers)
IPFS_API_KEY=your_pinata_api_key
IPFS_API_SECRET=your_pinata_api_secret

# Public IPFS gateway used by the browser to retrieve encrypted files.
# The data at this gateway is always ciphertext — safe to fetch publicly.
# Options:
#   https://gateway.pinata.cloud         (Pinata public gateway, no auth)
#   https://ipfs.io                      (Protocol Labs public gateway)
#   https://your-subdomain.mypinata.cloud (Pinata dedicated gateway)
IPFS_GATEWAY=https://gateway.pinata.cloud
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# ==============================================================================
# WEB3 / WALLET AUTHENTICATION
# ==============================================================================
# WalletConnect Cloud Project ID (Get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ==============================================================================
# NEXTAUTH (OPTIONAL GOOGLE OAUTH)
# ==============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
