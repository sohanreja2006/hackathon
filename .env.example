# ==============================================================================
# CYBER-10 Protocol Environment Configuration
# ==============================================================================

# WalletConnect Cloud Project ID (Get one at https://cloud.walletconnect.com)
# A default public fallback ID is provided in src/lib/wagmi.ts for development.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Server Session HMAC Secret for signing HttpOnly SIWE cookies
# In production, set to a strong 32+ character random string: openssl rand -base64 32
AUTH_SESSION_SECRET=your_super_secret_32_byte_hmac_key_here

# ==============================================================================
# PHASE 4 — PINATA / IPFS CONFIGURATION
# ==============================================================================

# Pinata JWT (SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_)
# Generate at: https://app.pinata.cloud/developers/api-keys
# Scope: pinFileToIPFS, pinJSONToIPFS, unpin (optional)
PINATA_JWT=your_pinata_jwt_token_here

# Public IPFS gateway used by the browser to retrieve encrypted files.
# The data at this gateway is always ciphertext — safe to fetch publicly.
# Options:
#   https://gateway.pinata.cloud         (Pinata public gateway, no auth)
#   https://ipfs.io                      (Protocol Labs public gateway)
#   https://your-subdomain.mypinata.cloud (Pinata dedicated gateway)
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# ==============================================================================
# PHASE 5 — SUPABASE METADATA DATABASE (DO NOT CONFIGURE IN PHASE 4)
# ==============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
